# Site
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=          # Supabase project URL
DATABASE_URL_PROVIDED=             # Supabase pooler connection string (for migrations)
SUPABASE_SERVICE_ROLE_KEY=         # Service role key (server only, never expose to client)

# LINE
NEXT_PUBLIC_LIFF_ID=               # LINE LIFF ID (from LINE Developers Console)
LINE_CHANNEL_ID=                   # LINE Channel ID (server only)
LINE_CHANNEL_ACCESS_TOKEN=         # LINE Channel Access Token (server only)
LINE_CHANNEL_SECRET=               # LINE Channel Secret (server only, for webhook signature verification)
SESSION_SECRET=                    # JWT signing secret (min 32 chars)

# Cron
CRON_SECRET=                       # Bearer token for cron job endpoints
CRON_PUBLIC_URL=                   # Base URL for cron job callbacks